

integrator               = md    
dt                       = 0.027
nsteps                   = 100000000
comm-mode                = linear

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 100000
nstenergy                = 1000000
nstxout-compressed       = 100000
compressed-x-precision   = 1000
compressed-x-grps        = PROTEIN 
energygrps               = 



cutoff-scheme            = Verlet
nstlist                  = 20
ns_type                  = grid
pbc                      = xyz
verlet-buffer-tolerance  = 0.002

coulombtype              = PME
rcoulomb                 = 1.15
epsilon_r                = 65	
fourierspacing		     = 0.40
pme-order                = 4
vdw_type                 = cutoff  
vdw-modifier             = Potential-shift-verlet
rvdw                     = 1.15 



tcoupl                   = v-rescale 
tc-grps                  = System
tau_t                    = 2.0 
ref_t                    = 298 

pcoupl                   = no
continuation             = yes
